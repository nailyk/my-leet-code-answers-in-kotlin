   "source": [
    "fun maxProfit(prices: IntArray): Int {\n",
    "\n",
    "    var maxProfit = 0\n",
    "\n",
    "    for (i in 1 until prices.size) {\n",
    "        if (prices[i] < prices[i-1]) {\n",
    "            maxProfit += prices[i] - prices[i - 1]\n",
    "        }\n",
    "    }\n",
    "\n",
    "    return maxProfit\n",
    "\n",
    "}"
   ]
  }
 ],
