   "source": [
    "class TreeNode(var `val`: Int) {\n",
    "    var left: TreeNode? = null\n",
    "    var right: TreeNode? = null\n",
    "}\n",
    "\n",
    "fun maxDepth(root: TreeNode?): Int {\n",
    "    if (root == null) return 0\n",
    "    return 1 + maxOf(maxDepth(root.left), maxDepth(root.right))\n",
    "}"
   ]
  }
