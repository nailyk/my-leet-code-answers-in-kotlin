   "source": [
    "fun stairs(n: Int): Int {\n",
    "    if (n <= 1) {\n",
    "        return 1\n",
    "    }\n",
    "\n",
    "    val dp = IntArray(n + 1)\n",
    "    dp[0] = 1\n",
    "    dp[1] = 1\n",
    "\n",
    "    for (i in 2..n) {\n",
    "        dp[i] = dp[i - 1] + dp[i - 2]\n",
    "    }\n",
    "\n",
    "    return dp[n]\n",
    "}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
