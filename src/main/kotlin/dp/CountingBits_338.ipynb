   "source": [
    "fun countBits(n: Int): IntArray {\n",
    "\n",
    "    val dp = IntArray(n + 1)\n",
    "    for (i in 1..n) {\n",
    "        dp[i] = dp[i / 2] + i % 2\n",
    "    }\n",
    "    return dp\n",
    "}"
   ]
  },
