   "source": [
    "import linked_list.ListNode\n",
    "\n",
    "fun hasCycle(head: ListNode?): Boolean {\n",
    "\n",
    "    var slow = head\n",
    "    var fast = head\n",
    "\n",
    "    while (fast != null && fast.next != null) {\n",
    "        slow = slow?.next\n",
    "        fast = fast.next?.next\n",
    "        if (slow == fast) return true\n",
    "    }\n",
    "    return false\n",
    "}"
   ]
  }
 ],
