   "source": [
    "fun canJump(nums: IntArray): Boolean {\n",
    "    var goal = nums.lastIndex\n",
    "\n",
    "    for (i in nums.lastIndex - 1 downTo 0) {\n",
    "        if (i + nums[i] >= goal) {\n",
    "            goal = i\n",
    "        }\n",
    "    }\n",
    "\n",
    "    return goal == 0\n",
    "}\n"
   ]
  }
 ],
