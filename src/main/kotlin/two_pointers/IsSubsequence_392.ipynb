   "source": [
    "fun isSubsequence(s: String, t: String): Boolean {\n",
    "    var i = 0\n",
    "    var j = 0\n",
    "\n",
    "    while (i < s.length && j < t.length) {\n",
    "        if (s[i] == t[j]) {\n",
    "            i++\n",
    "        }\n",
    "        j++\n",
    "    }\n",
    "\n",
    "    return i == s.length\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "println(isSubsequence(\"abc\", \"ahbdc\"))"
   ]
